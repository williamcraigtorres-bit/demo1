body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f6f5;
    color: #111;
  }
  
  header {
    background: #0b3d2e;
    color: white;
    padding: 30px 20px;
    text-align: center;
  }
  
  header h1 {
    margin: 0 0 20px;
  }
  
  #search {
    width: 90%;
    max-width: 420px;
    padding: 12px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
  }
  
  .players {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 30px;
  }
  
  @media (max-width: 900px) {
    .players {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 600px) {
    .players {
      grid-template-columns: 1fr;
    }
  }
  
  .player-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  
  .player-card img {
    width: 100%;
    height: 430px;
    object-fit: cover;
    object-position: center;
  }
  
  .player-info {
    padding: 16px;
  }
  
  .rank {
    font-size: 14px;
    color: #0b7a53;
    font-weight: bold;
  }
  
  .player-info h2 {
    margin: 8px 0;
    font-size: 22px;
  }
  
  .player-info p {
    margin: 4px 0;
    color: #555;
  }